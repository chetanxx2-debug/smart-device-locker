<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Red Shield Warning Icon -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒"
        android:textSize="64sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DEVICE LOCKED"
        android:textColor="@color/red_locked"
        android:textSize="26sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tiger Locker Authorized Finance Protection"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp" />

    <!-- Message Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="14dp"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REASON FOR LOCK:"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLockMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Your monthly EMI is overdue. Please pay your pending installment immediately to restore device access."
                android:textColor="@color/white"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#334155"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvLockDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device ID: DEV-101 | Status: Restricted"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btnCallRetailer"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:backgroundTint="@color/orange_primary"
        android:text="📞 Call Retailer / Support"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/btnEmergencyDialer"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#334155"
        android:text="🚨 Emergency Call (112)"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textAllCaps="false" />

</LinearLayout>
